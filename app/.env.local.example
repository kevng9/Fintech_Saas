# Fintech Aura Analyst demo - local environment
# Copy to app/.env.local and fill in. Never commit .env.local.
# The simulator reads this same file, so a demo environment is described once.

# ── SingleStore engine (application and simulator writes) ────────────────────
DEMO_DB_HOST=
DEMO_DB_PORT=3306
DEMO_DB_USER=
DEMO_DB_PASSWORD=
DEMO_DB_NAME=fintech_demo

# ── Deterministic demo data ──────────────────────────────────────────────────
DEMO_DEFAULT_SEED=20260725
# Logical epoch: the instant the demo baseline ends and the live stream begins.
# Use an ISO-8601 UTC timestamp, or run the seeder with --epoch now.
DEMO_DEFAULT_EPOCH=2026-07-25T09:00:00Z
DEMO_BASELINE_DAYS=7
DEMO_ALLOWED_SPEEDS=0.5,1,2,5,20

# ── Aura Analyst API (server side only, never NEXT_PUBLIC_*) ────────────────
# live    fail if Aura is unavailable
# fixture always use reviewed stored responses
# auto    try live, then offer a visible operator-controlled fallback
ANALYST_MODE=auto
ANALYST_ORG_ID=
ANALYST_PROJECT_ID=
ANALYST_REGION=us-east-1
ANALYST_TIMEOUT_SECONDS=90
ANALYST_MAX_ROWS=500
ANALYST_MAX_MESSAGE_CHARS=2000

# One Domain-scoped key per anchor. Optionally override the derived Analyst
# *base* URL with ANALYST_A{N}_ENDPOINT (…/analyst). Do not include /chat,
# /query, or /conversation-starters — the app appends those paths.
ANALYST_A1_API_KEY=
ANALYST_A1_ENDPOINT=
ANALYST_A2_API_KEY=
ANALYST_A2_ENDPOINT=
ANALYST_A3_API_KEY=
ANALYST_A3_ENDPOINT=
ANALYST_A4_API_KEY=
ANALYST_A4_ENDPOINT=
ANALYST_A5_API_KEY=
ANALYST_A5_ENDPOINT=
ANALYST_A6_API_KEY=
ANALYST_A6_ENDPOINT=
ANALYST_A7_API_KEY=
ANALYST_A7_ENDPOINT=
ANALYST_A8_API_KEY=
ANALYST_A8_ENDPOINT=

# ── Demo access control ──────────────────────────────────────────────────────
# Role used when no administrator token is presented.
DEMO_DEFAULT_ROLE=presenter
# When set, administrator actions (reset, inject, pause, speed, mode) require
# this token. Leave empty for a laptop demo. Always set it for a hosted demo,
# and put an authenticating proxy in front of the app.
DEMO_ADMIN_TOKEN=
